# Copiar este archivo como `.env` y completar los valores reales.
# El `.env` real NUNCA se sube al repositorio.

# Secreto para firmar la cookie de sesión.
# Generar uno con:  python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=

# Ruta de la base de datos SQLite (archivo único).
DATABASE_URL=sqlite:///./estudio.db
