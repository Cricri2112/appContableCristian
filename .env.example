# Copiar este archivo como `.env` y completar los valores reales.
# El `.env` real NUNCA se sube al repositorio.

# Secreto para firmar la cookie de sesión.
# Generar uno con:  python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=

# Clave de cifrado del vault de credenciales (Fernet).
# Generarla UNA SOLA VEZ con:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# ANTES de cargar credenciales reales, guardala en tu gestor de contraseñas.
# Si se pierde, las credenciales cifradas son irrecuperables (por diseño).
FERNET_KEY=

# Email resumen diario (Brevo). La clave se crea en Brevo → SMTP & API → API Keys.
# El remitente debe estar verificado en Brevo (Senders).
# El email de DESTINO no va acá: se configura en la app (Configuración → Notificaciones).
BREVO_API_KEY=
EMAIL_REMITENTE=

# Dirección de la app (link al pie del email).
APP_URL=http://localhost:8000

# Carpeta local de respaldos diarios de la base.
RESPALDOS_DIR=./respaldos

# Ruta de la base de datos SQLite (archivo único).
DATABASE_URL=sqlite:///./estudio.db
