# Copiar este archivo como `.env` y completar los valores reales.
# El `.env` real NUNCA se sube al repositorio.

# Secreto para firmar la cookie de sesión.
# Generar uno con:  python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=

# Clave de cifrado del vault de credenciales (Fernet).
# Generarla UNA SOLA VEZ con:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# ANTES de cargar credenciales reales, guardala en tu gestor de contraseñas.
# Si se pierde, las credenciales cifradas son irrecuperables (por diseño).
FERNET_KEY=

# Ruta de la base de datos SQLite (archivo único).
DATABASE_URL=sqlite:///./estudio.db
